// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: reviews
// Document ID: auto-generated
// Fields:
//   - dishName: string (required, 1-100 chars)
//   - restaurantName: string (required, 1-100 chars)
//   - content: string (required, 1-2000 chars)
//   - rating: number (required, 1-5)
//   - category: string (required, one of ['good', 'bad', 'other'])
//   - authorName: string (required, 1-50 chars)
//   - isAnonymous: bool (required)
//   - upvotes: number (required, >= 0)
//   - createdAt: timestamp (required)
//   - userId: string (required, matches auth.uid or 'anonymous')
//   - status: string (required, one of ['active', 'done'])
//
// Subcollection: reviews/{reviewId}/voters
// Document ID: user UID
// Fields:
//   - uid: string (required, matches auth.uid)
//   - timestamp: timestamp (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['dishName', 'restaurantName', 'content', 'rating', 'category', 'authorName', 'isAnonymous', 'upvotes', 'createdAt', 'userId', 'status']) &&
             data.keys().hasOnly(['dishName', 'restaurantName', 'content', 'rating', 'category', 'authorName', 'isAnonymous', 'upvotes', 'createdAt', 'userId', 'status']) &&
             data.dishName is string && data.dishName.size() >= 1 && data.dishName.size() <= 100 &&
             data.restaurantName is string && data.restaurantName.size() >= 1 && data.restaurantName.size() <= 100 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.category in ['good', 'bad', 'other'] &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
             data.isAnonymous is bool &&
             data.upvotes is number && data.upvotes >= 0 &&
             data.createdAt is timestamp &&
             data.userId is string &&
             data.status in ['active', 'done'];
    }

    function isValidVoter(data) {
      return data.keys().hasAll(['uid', 'timestamp']) &&
             data.keys().hasOnly(['uid', 'timestamp']) &&
             data.uid == request.auth.uid &&
             data.timestamp is timestamp;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "1260031-8@g.puiching.edu.mo" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /reviews/{reviewId} {
      // Anyone can read reviews (public access)
      allow read: if true;
      
      // Anyone can create reviews (unauthenticated allowed)
      allow create: if isValidReview(request.resource.data) && 
                      request.resource.data.upvotes == 0 &&
                      (isAuthenticated() ? request.resource.data.userId == request.auth.uid : request.resource.data.userId == 'anonymous');

      // Update rules:
      // 1. Owner can update their own review (except upvotes)
      // 2. Others can ONLY increment upvotes or toggle status
      allow update: if (
        // Owner update (must be authenticated if they have a userId)
        (isAuthenticated() && isOwner(resource.data.userId) && 
         isValidReview(request.resource.data) && 
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.upvotes == resource.data.upvotes) ||
        // Upvote update (others)
        ((isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']) &&
          request.resource.data.upvotes == resource.data.upvotes + 1 &&
          getAfter(/databases/$(database)/documents/reviews/$(reviewId)/voters/$(request.auth.uid)) != null) ||
         (!isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']) &&
          request.resource.data.upvotes == resource.data.upvotes + 1)) ||
        // Status toggle (anyone can toggle status for now as it's a shared state in this simple app)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status in ['active', 'done'])
      );

      allow delete: if isAdmin() || isOwner(resource.data.userId);

      match /voters/{voterId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && voterId == request.auth.uid && isValidVoter(request.resource.data);
        allow delete: if false; // Votes are permanent for now
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
